idth=\"400\" height=\"500\"\n                 loading=\"lazy\" decoding=\"async\">\n          </span>\n          <span class=\"luvit-step__body\">\n            <span class=\"luvit-step__title\">كريم الترطيب والترميم</span>\n          </span>\n        </li>\n        <li class=\"luvit-step\">\n          <span class=\"luvit-step__num\">٥</span>\n          <span class=\"luvit-step__media\">\n            <img src=\"https://plasmajo.com/wp-content/uploads/2026/08/luvit-high-protection-sunscreen-1-bottle.webp\" alt=\"واقي الشمس اليومي · SPF50+‎\" width=\"400\" height=\"500\"\n                 loading=\"lazy\" decoding=\"async\">\n          </span>\n          <span class=\"luvit-step__body\">\n            <span class=\"luvit-step__title\">واقي الشمس اليومي · SPF50+‎</span>\n          </span>\n        </li>\n      </ol>\n    </article>\n\n    <div class=\"luvit-section__foot\">\n      <a class=\"luvit-btn luvit-btn--ghost\" href=\"/routines\">كل الروتينات</a>\n    </div>\n\n  </div>\n</section>",
  "8b90fbf": "<section class=\"luvit-section luvit-section--dark luvit-deep luvit-cut-top\" data-nav-bg=\"dark\"\n         data-luvit-bubbles=\"10\" id=\"quiz\">\n  <span class=\"luvit-deep__rays\" aria-hidden=\"true\"></span>\n  <div class=\"luvit-section__inner\">\n    <div class=\"luvit-quiz luvit-quiz--on-dark\" data-luvit=\"reveal\">\n      <h2 class=\"luvit-quiz__q\">شو أكثر إشي بيزعجك ببشرتك؟</h2>\n\n      <div class=\"luvit-optiongrid\">\n\n        <label class=\"luvit-option\">\n          <input type=\"radio\" name=\"home-quiz\" value=\"dry\">\n          <span class=\"luvit-option__icon\" aria-hidden=\"true\">💧</span>\n          <span class=\"luvit-option__label\">جفاف وشدّ</span>\n        </label>\n        <label class=\"luvit-option\">\n          <input type=\"radio\" name=\"home-quiz\" value=\"oil\">\n          <span class=\"luvit-option__icon\" aria-hidden=\"true\">✦</span>\n          <span class=\"luvit-option__label\">لمعة ودهون</span>\n        </label>\n        <label class=\"luvit-option\">\n          <input type=\"radio\" name=\"home-quiz\" value=\"acne\">\n          <span class=\"luvit-option__icon\" aria-hidden=\"true\">◇</span>\n          <span class=\"luvit-option__label\">حبوب</span>\n        </label>\n        <label class=\"luvit-option\">\n          <input type=\"radio\" name=\"home-quiz\" value=\"calm\">\n          <span class=\"luvit-option__icon\" aria-hidden=\"true\">✿</span>\n          <span class=\"luvit-option__label\">احمرار وحساسية</span>\n        </label>\n      </div>\n\n      <div class=\"luvit-quiz__foot\">\n        <a href=\"/quiz\" class=\"luvit-btn luvit-btn--arrow\">كمّلي الاختبار</a>\n        <p class=\"luvit-quiz__hint\">أقل من دقيقة · ٥ أسئلة بس.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"luvit-wave luvit-wave--drift\" style=\"--wave-fill:#FFFFFF;background:#0B9198\" aria-hidden=\"true\"></div>",
  "1d1f09b": "<section class=\"luvit-section band-mist\" data-nav-bg=\"light\" id=\"result\">\n  <div class=\"luvit-section__inner\">\n    <div class=\"luvit-section__head luvit-section__head--start\" data-luvit=\"reveal\">\n      <p class=\"luvit-section__eyebrow\">One real case</p>\n      <h2 class=\"luvit-section__title\">أسبوعان، وحالة وحدة بس</h2>\n      <p class=\"luvit-section__sub\">\n        ما منعرض قبل وبعد لكل وحدة، لأن ما عنا غير حالة وحدة موثّقة لهلأ.\n        هاي هي، وبنقول عنها كل اللي منعرفه.\n      </p>\n    </div>\n\n    <div class=\"luvit-case\" data-luvit=\"reveal\">\n      <div class=\"luvit-case__pair\">\n        <figure class=\"luvit-case__fig\">\n          <img src=\"/wp-content/uploads/2026/09/luvit-case-a-before.webp\"\n               alt=\"بشرة الخد قبل بداية الروتين\" width=\"260\" height=\"406\"\n               loading=\"lazy\" decoding=\"async\">\n          <span class=\"luvit-case__tag\">قبل</span>\n        </figure>\n        <figure class=\"luvit-case__fig\">\n          <img src=\"/wp-content/uploads/2026/09/luvit-case-a-after.webp\"\n               alt=\"نفس المنطقة بعد أسبوعين من الروتين\" width=\"278\" height=\"434\"\n               loading=\"lazy\" decoding=\"async\">\n          <span class=\"luvit-case__tag\">بعد أسبوعين</span>\n        </figure>\n      </div>\n\n      <div class=\"luvit-case__body\">\n        <p class=\"luvit-case__note\">\n          <strong>من وين الصورة:</strong> حالة تابعتها د. رَماس عبدالنبي، مستشارة بشرة\n          وشريكة للعلامة، ونشرتها على حسابها. البطل بحالتها كان المرطب مع وقف\n          المنتجات اللي كانت بتهيّج بشرتها.\n        </p>\n        <p class=\"luvit-case__note\">\n          <strong>وشو ما منقوله:</strong> هاي حالة وحدة، والنتيجة بتختلف من بشرة\n          لبشرة وحسب الالتزام والمدة والعوامل اللي برّا الروتين. مش وعداً، ولا\n          متوسّطاً لنتائج.\n        </p>\n        <div class=\"luvit-section__foot\">\n          <a class=\"luvit-btn luvit-btn--arrow\" href=\"/quiz\">شوفي أي روتين يناسب بشرتك</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
  "d2f1f55": "<section class=\"luvit-section luvit-section--dark luvit-deep luvit-cut-top\" data-nav-bg=\"dark\"\n         data-luvit-bubbles=\"14\" id=\"ingredients\">\n  <span class=\"luvit-deep__rays\" aria-hidden=\"true\"></span>\n  <div class=\"luvit-section__inner\">\n    <div class=\"luvit-section__head luvit-section__head--start\" data-luvit=\"reveal\">\n      <h2 class=\"luvit-section__title\">كل مادة إلها شغلة</h2>\n      <p class=\"luvit-section__sub\">\n        خدي سيروم فيتامين سي مثالاً: هون كل مادة فيه، وشو بتعمل لبشرتك.\n      </p>\n    </div>\n\n    <div class=\"luvit-ing-split\" data-luvit=\"reveal\">\n      <figure class=\"luvit-ing-split__shot\">\n        <img class=\"luvit-shot-img\" src=\"https://plasmajo.com/wp-content/uploads/2026/09/luvit-vitamin-c-serum-1-bottle-soft.webp\" alt=\"عبوة سيروم فيتامين سي\"\n             width=\"386\" height=\"1192\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"luvit-shot-mirror\" src=\"https://plasmajo.com/wp-content/uploads/2026/09/luvit-vitamin-c-serum-1-bottle-soft.webp\" alt=\"\"\n             width=\"386\" height=\"1192\" loading=\"lazy\" decoding=\"async\">\n        <figcaption class=\"luvit-shot-cap\">سيروم فيتامين سي</figcaption>\n      </figure>\n\n      <div class=\"luvit-ing luvit-ing--on-dark\" data-luvit=\"stagger\">\n\n        <div class=\"luvit-ing__row\">\n          <span class=\"luvit-ing__pct\">10%</span>\n          <div class=\"luvit-ing__body\">\n            <p class=\"luvit-ing__name\">فيتامين سي</p>\n            <p class=\"luvit-ing__note\">إشراق ونضارة</p>\n          </div>\n        </div>\n        <div class=\"luvit-ing__row\">\n          <span class=\"luvit-ing__pct\">2%</span>\n          <div class=\"luvit-ing__body\">\n            <p class=\"luvit-ing__name\">نياسيناميد</p>\n            <p class=\"luvit-ing__note\">تضييق المسام</p>\n          </div>\n        </div>\n        <div class=\"luvit-ing__row\">\n          <span class=\"luvit-ing__pct\">2%</span>\n          <div class=\"luvit-ing__body\">\n            <p class=\"luvit-ing__name\">حمض هيالورونيك</p>\n            <p class=\"luvit-ing__note\">ترطيب عميق</p>\n          </div>\n        </div>\n        <div class=\"luvit-ing__row\">\n          <span class=\"luvit-ing__pct\">2%</span>\n          <div class=\"luvit-ing__body\">\n            <p class=\"luvit-ing__name\">بانثينول</p>\n            <p class=\"luvit-ing__note\">ترطيب حاجز البشرة</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"luvit-section__foot\">\n      <a href=\"/product/vitamin-c-serum\" class=\"luvit-btn luvit-btn--arrow\">شوفي السيروم</a>\n      <a href=\"/products#ingredients\" class=\"luvit-btn luvit-btn--ghost luvit-btn--on-dark\">وشو بيعمل البانثينول بباقي المنتجات</a>\n    </div>\n  </div>\n</section>\n\n<div class=\"luvit-wave luvit-wave--drift\" style=\"--wave-fill:#FFFFFF;background:#0B9198\" aria-hidden=\"true\"></div>",
  "0a83774": "<section class=\"luvit-section band-light\" data-nav-bg=\"light\" id=\"why\">\n  <div class=\"luvit-section__inner\">\n    <div class=\"luvit-split\">\n\n      <div class=\"luvit-split__aside\">\n        <div class=\"luvit-section__head luvit-section__head--start\" data-luvit=\"reveal\">\n          <h2 class=\"luvit-section__title\">العناية مش رفاهية، هي حقّك</h2>\n          <p class=\"luvit-section__sub\">\n            ما منبيع وعود. منبيع وضوح، ومنضلّ معك بعد الطلب.\n          </p>\n        </div>\n      </div>\n\n      <ol class=\"luvit-split__list\" data-luvit=\"stagger\">\n\n        <li class=\"luvit-split__item\">\n          <span class=\"luvit-split__n\">01</span>\n          <h3 class=\"luvit-split__t\">روتين على قدّك</h3>\n          <p class=\"luvit-split__p\">منسألك شو بيزعجك ببشرتك ومنركّب الخطوات على أساسه · مش نفس الوصفة لكل وحدة.</p>\n        </li>\n        <li class=\"luvit-split__item\">\n          <span class=\"luvit-split__n\">02</span>\n          <h3 class=\"luvit-split__t\">ترتيب مش تشكيلة</h3>\n          <p class=\"luvit-split__p\">ما منبيعك أربع قطع، منبيعك ترتيباً. نفس القطع بترتيب غلط بتعطي أقل.</p>\n        </li>\n        <li class=\"luvit-split__item\">\n          <span class=\"luvit-split__n\">03</span>\n          <h3 class=\"luvit-split__t\">النتيجة بتاخد وقت</h3>\n          <p class=\"luvit-split__p\">ما منوعد بأسبوع. البشرة بتتجدّد على مهلها، ومنقولك هيك من البداية.</p>\n        </li>\n        <li class=\"luvit-split__item\">\n          <span class=\"luvit-split__n\">04</span>\n          <h3 class=\"luvit-split__t\">بتدفعي لمّا يوصلك</h3>\n          <p class=\"luvit-split__p\">الدفع عند الاستلام · افتحي الطرد وشوفي الختوم قدام المندوب.</p>\n        </li>\n        <li class=\"luvit-split__item\">\n          <span class=\"luvit-split__n\">05</span>\n          <h3 class=\"luvit-split__t\">وسؤالك مفتوح</h3>\n          <p class=\"luvit-split__p\">قبل الطلب وبعده. الاستشارة مجانية وما بتنتهي لمّا تدفعي.</p>\n        </li>\n      </ol>\n\n    </div>\n  </div>\n</section>",
  "a200f43": "<section class=\"luvit-section luvit-section--dark luvit-deep luvit-cut-top\" data-nav-bg=\"dark\"\n         data-luvit-bubbles=\"12\" id=\"reviews\">\n  <span class=\"luvit-deep__rays\" aria-hidden=\"true\"></span>\n  <div class=\"luvit-section__inner\">\n    <div class=\"luvit-section__head\" data-luvit=\"reveal\">\n      <p class=\"luvit-section__eyebrow\">In their words</p>\n      <h2 class=\"luvit-section__title\">كلام زبوناتنا زي ما وصلنا</h2>\n      <p class=\"luvit-section__sub\">\n        منسوخ حرفياً من رسائلهن، بلا تصليح إملاء وبلا إعادة صياغة.\n      </p>\n    </div>\n\n    <div class=\"luvit-quotes\" data-luvit=\"stagger\">\n\n      <figure class=\"luvit-quote luvit-quote--wide\">\n        <span class=\"luvit-quote__mark\" aria-hidden=\"true\">&rdquo;</span>\n        <blockquote class=\"luvit-quote__text\">انا مبسوطة من نتيجة الفيتامين سي الحمدلله أبدا ما تحسست منه وبحطه كل يوم قبل ما انام وبعدين مرطب وكان عندي حبة كبيرة بلش ينشفها</blockquote>\n        <figcaption class=\"luvit-quote__by\">زبونة · رسالة خاصة نشرتها Luv it على إنستجرام</figcaption>\n      </figure>\n      <figure class=\"luvit-quote luvit-quote--wide\">\n        <span class=\"luvit-quote__mark\" aria-hidden=\"true\">&rdquo;</span>\n        <blockquote class=\"luvit-quote__text\">انا مبسوطة كتير ع الغسول و المرطب لطيفين جدا و بتحسي الوجه بينظف بحق الله. اختي وجهها فرق كتير ماشالله الحبوب خفت و مفتتح الحمدلله</blockquote>\n        <figcaption class=\"luvit-quote__by\">زبونة · رسالة خاصة نشرتها Luv it على إنستجرام</figcaption>\n      </figure>\n      <figure class=\"luvit-quote\">\n        <span class=\"luvit-quote__mark\" aria-hidden=\"true\">&rdquo;</span>\n        <blockquote class=\"luvit-quote__text\">وجهي من الجهة اليمين صار اهدى بكثير ما بعرف ليش هاي الجهة دايما متهيجة هسا صارت احسن واهدى</blockquote>\n        <figcaption class=\"luvit-quote__by\">زبونة · من محادثة استشارة نشرتها د. رَماس عبدالنبي</figcaption>\n      </figure>\n      <figure class=\"luvit-quote\">\n        <span class=\"luvit-quote__mark\" aria-hidden=\"true\">&rdquo;</span>\n        <blockquote class=\"luvit-quote__text\">مافي لسعة بعد المرطب والغسول</blockquote>\n        <figcaption class=\"luvit-quote__by\">زبونة · من نفس المحادثة</figcaption>\n      </figure>\n      <figure class=\"luvit-quote\">\n        <span class=\"luvit-quote__mark\" aria-hidden=\"true\">&rdquo;</span>\n        <blockquote class=\"luvit-quote__text\">ثاني شي حستيه بصغر المسام</blockquote>\n        <figcaption class=\"luvit-quote__by\">زبونة · من محادثة خاصة نشرتها د. رَماس</figcaption>\n      </figure>\n    </div>\n  </div>\n</section>",
  "5ce3e55": "<section class=\"luvit-cta luvit-deep luvit-cut-top\" data-nav-bg=\"dark\" data-luvit-bubbles=\"16\">\n  <span class=\"luvit-deep__rays\" aria-hidden=\"true\"></span>\n  <div class=\"luvit-cta__panel\" data-luvit=\"reveal\">\n    <h2 class=\"luvit-cta__title luvit-cta__accent\">بشرتك مستنّية مِنِّك خطوة.</h2>\n    <p class=\"luvit-cta__sub\">ابدئي باختبار قصير، ومنبنيلك روتين على قدّك، والدفع عند الاستلام.</p>\n    <a href=\"/quiz\" class=\"luvit-btn luvit-btn--arrow\">اكتشفي روتينك</a>\n  </div>\n</section>"
 },
