  "5db08dc": "<section class=\"luvit-section band-light\" data-nav-bg=\"light\" id=\"routine\">\n  <div class=\"luvit-section__inner\">\n\n    <div class=\"luvit-section__head\" data-luvit=\"reveal\">\n      <h2 class=\"luvit-section__title\">الترتيب هو الفكرة كلها</h2>\n      <p class=\"luvit-section__sub\">\n        أربع روتينات · نفس الترتيب بكلهن، واللي بيتغيّر المنتجات\n        حسب اللي بدك توصليله. وسعر الروتين مجموع قطعه بالضبط.\n      </p>\n    </div>\n\n\n    <article class=\"luvit-home-rt\" data-luvit=\"reveal\">\n      <div class=\"luvit-home-rt__top\">\n        <div class=\"luvit-home-rt__id\">\n          <p class=\"luvit-home-rt__eyebrow\">Hydration & Support</p>\n          <h3 class=\"luvit-home-rt__title\">\n            <a href=\"/routines/hydration\">روتين الترطيب والدعم اليومي</a>\n          </h3>\n          <p class=\"luvit-home-rt__who\">للبشرة الجافة والحسّاسة</p>\n        </div>\n        <div class=\"luvit-home-rt__buy\">\n          <span class=\"luvit-home-rt__price\"><span dir=\"ltr\">60.00</span> د.أ</span>\n          <a class=\"luvit-btn luvit-btn--arrow\" href=\"/routines/hydration\">شوفي الروتين</a>\n        </div>\n      </div>\n\n      <ol class=\"luvit-steps luvit-steps--compact\">\n\n        <li class=\"luvit-step\">\n          <span class=\"luvit-step__num\">١</span>\n          <span class=\"luvit-step__media\">\n            <img src=\"https://plasmajo.com/wp-content/uploads/2026/08/luvit-hydrating-gel-cleanser-1-bottle.webp\" alt=\"غسول البشرة الجافة والحساسة\" width=\"400\" height=\"500\"\n                 loading=\"eager\" decoding=\"async\">\n          </span>\n          <span class=\"luvit-step__body\">\n            <span class=\"luvit-step__title\">غسول البشرة الجافة والحساسة</span>\n          </span>\n        </li>\n        <li class=\"luvit-step\">\n          <span class=\"luvit-step__num\">٢</span>\n          <span class=\"luvit-step__media\">\n            <img src=\"https://plasmajo.com/wp-content/uploads/2026/08/luvit-8d-hy